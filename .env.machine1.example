# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - MÁY 1 (MAIN SERVER)
# ==========================================================
# Sử dụng: Tạo hoặc sao chép thành file .env trên Máy 1 trước khi chạy:
#   docker compose -f docker-compose.machine1.yml up -d
#   cd backend && npm run dev
# ==========================================================

# 1. THÔNG TIN XÁC THỰC CHUNG
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
JWT_SECRET=warehouse_secret_key_super_secure_2026
PORT=5000

# 2. CÁC DATABASE CỤC BỘ TRÊN MÁY 1 (LOCALHOST)
POSTGRES_HOST_CENTRAL=localhost
POSTGRES_PORT_CENTRAL=5436
POSTGRES_DB_CENTRAL=warehouse_central

POSTGRES_HOST_HN=localhost
POSTGRES_PORT_HN=5433
POSTGRES_DB_HN=warehouse_hn

# 3. KẾT NỐI TỚI 2 KHO CHI NHÁNH TRÊN MÁY 2 QUA MẠNG LAN
# [QUAN TRỌNG]: Thay <IP_LAN_MAY_2> bằng địa chỉ IP thật của Máy 2 (ví dụ: 192.168.1.103)
POSTGRES_HOST_DN=<IP_LAN_MAY_2>
POSTGRES_PORT_DN=5434
POSTGRES_DB_DN=warehouse_dn

POSTGRES_HOST_HCM=<IP_LAN_MAY_2>
POSTGRES_PORT_HCM=5435
POSTGRES_DB_HCM=warehouse_hcm

# 4. EVENT STORE VÀ MESSAGE BROKER TRÊN MÁY 1
MONGO_PORT=27018
MONGO_URI=mongodb://127.0.0.1:27018/warehouse_events
KAFKA_BROKERS=localhost:9094
