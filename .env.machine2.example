# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - MÁY 2 (DISTRIBUTED NODES)
# ==========================================================
# Sử dụng: Tạo hoặc sao chép thành file .env trên Máy 2 trước khi chạy:
#   docker compose -f docker-compose.machine2.yml up -d
# ==========================================================

# 1. THÔNG TIN XÁC THỰC CƠ SỞ DỮ LIỆU
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# 2. CỔNG MỞ QUA MẠNG LAN CỦA 2 KHO CHI NHÁNH
# (Cần mở Inbound Firewall cổng 5434 và 5435 trên Máy 2)
POSTGRES_PORT_DN=5434
POSTGRES_DB_DN=warehouse_dn

POSTGRES_PORT_HCM=5435
POSTGRES_DB_HCM=warehouse_hcm
