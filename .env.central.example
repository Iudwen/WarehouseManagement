# ==========================================================
# CẤU HÌNH CHO MÁY CENTRAL (CENTRAL SERVER MACHINE)
# ==========================================================
# Đổi tên file này thành .env trên Máy Central trước khi chạy:
# docker compose -f docker-compose.central.yml up -d
# và chạy backend: cd backend && npm run dev
# ==========================================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# ----------------------------------------------------------
# 1. KẾT NỐI SANG 3 KHO CHI NHÁNH TRÊN MÁY NHÁNH
# (Thay thế 192.168.1.X bằng địa chỉ IP LAN thật của Máy Nhánh)
# ----------------------------------------------------------
POSTGRES_HOST_HN=192.168.1.X
POSTGRES_PORT_HN=5433
POSTGRES_DB_HN=warehouse_hn

POSTGRES_HOST_DN=192.168.1.X
POSTGRES_PORT_DN=5434
POSTGRES_DB_DN=warehouse_dn

POSTGRES_HOST_HCM=192.168.1.X
POSTGRES_PORT_HCM=5435
POSTGRES_DB_HCM=warehouse_hcm

# ----------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU VÀ DỊCH VỤ TRUNG TÂM (CHẠY TẠI MÁY CENTRAL)
# ----------------------------------------------------------
POSTGRES_HOST_CENTRAL=localhost
POSTGRES_PORT_CENTRAL=5436
POSTGRES_DB_CENTRAL=warehouse_central

MONGO_PORT=27018
MONGO_URI=mongodb://127.0.0.1:27018/warehouse_events

KAFKA_BROKERS=localhost:9094
JWT_SECRET=warehouse_secret_key_super_secure_2026
PORT=5000
