{
  "name": "warehouse-backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/app.js",
    "worker": "ts-node src/workers/outboxWorker.ts",
    "worker:all": "ts-node src/workers/outboxWorker.ts --all-nodes",
    "worker:once": "ts-node src/workers/outboxWorker.ts --once",
    "test": "node tests/test_unit_source_confirm.js && node tests/test_relay_without_created_after.js && node tests/test_outbox_pipeline_verification.js",
    "test:relay": "node tests/test_relay_without_created_after.js",
    "test:pipeline": "node tests/test_outbox_pipeline_verification.js",
    "test:unit": "node tests/test_unit_source_confirm.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
